# Reference only. Spring Boot does not read this file automatically.
# Export these values in your shell, IDE run configuration, container, or Render
# environment. Never commit a populated copy.

# MongoDB is required for the durable single-owner platform records.
# The database name must be tradingassistant.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/tradingassistant?retryWrites=true&w=majority

# Comma-separated browser origins. Empty means no cross-origin browser access.
CORS_ALLOWED_ORIGINS=

# Maintenance jobs. No job places, modifies or executes a trade.
PLATFORM_JOBS_ENABLED=true
TOKEN_CLEANUP_CRON=0 15 * * * *
NOTIFICATION_RETENTION_DAYS=30
TOKEN_RETENTION_DAYS=7

# Read-only SmartAPI market data. Order placement is not implemented.
SMARTAPI_ENABLED=false

SMARTAPI_API_KEY=
SMARTAPI_CLIENT_CODE=
SMARTAPI_PIN=
SMARTAPI_TOTP_SECRET=

# Required request metadata when SMARTAPI_ENABLED=true. The SmartAPI login
# endpoint rejects an otherwise valid login with AB1012 when these headers are absent.
SMARTAPI_CLIENT_LOCAL_IP=
SMARTAPI_CLIENT_PUBLIC_IP=
SMARTAPI_MAC_ADDRESS=

# Optional endpoint and reliability overrides.
SMARTAPI_BASE_URL=https://apiconnect.angelone.in
SMARTAPI_WEBSOCKET_URL=wss://smartapisocket.angelone.in/smart-stream
SMARTAPI_INSTRUMENT_MASTER_URL=https://margincalculator.angelone.in/OpenAPI_File/files/OpenAPIScripMaster.json
SMARTAPI_STATE=prod
SMARTAPI_CONNECT_TIMEOUT=5s
SMARTAPI_READ_TIMEOUT=20s
SMARTAPI_SESSION_EXPIRY_SKEW=60s
SMARTAPI_MAX_RETRIES=2
SMARTAPI_RETRY_BASE_DELAY=250ms
SMARTAPI_RETRY_MAX_DELAY=2s

# Live subscription supervisor. Configured instruments are the baseline; every
# watchlist item is added automatically. Numeric tokens pass through; aliases
# such as NSE_CASH:NIFTY and NSE_FO:NIFTY resolve from the instrument master.
LIVE_MARKET_ENABLED=true
LIVE_MARKET_INSTRUMENTS=NSE_CASH:2885,NSE_CASH:NIFTY,NSE_CASH:BANKNIFTY,NSE_FO:NIFTY
LIVE_MARKET_INTERVAL=FIVE_MINUTE
LIVE_MARKET_HISTORY_DAYS=10
LIVE_MARKET_INCLUDE_WATCHLISTS=true
LIVE_MARKET_MAX_INSTRUMENTS=200
LIVE_MARKET_ALIAS_CACHE_TTL=10m
LIVE_MARKET_RECONCILE_INTERVAL_MS=15000
LIVE_MARKET_RECONCILE_INITIAL_DELAY_MS=1000
LIVE_TICK_MAX_AGE=2m
LIVE_CANDLE_MAX_AGE=10m

# Read-only option-chain staging for monitored cash/index underlyings.
# Only the nearest expiry and the closest strikes are quoted.
LIVE_OPTION_CHAIN_ENABLED=true
LIVE_OPTION_CHAIN_STRIKES_EACH_SIDE=10
LIVE_OPTION_CHAIN_REFRESH_INTERVAL_MS=30000
LIVE_OPTION_CHAIN_QUOTE_BATCH_SIZE=50

# Reference option trade plan and premium monitoring.
TRADE_PLAN_DELTA_FALLBACK=0.50
TRADE_PLAN_FALLBACK_TARGET_PERCENT=40
TRADE_PLAN_FALLBACK_STOP_PERCENT=20
TRADE_PLAN_PREMIUM_REFRESH_MS=30000
TRADE_PLAN_PREMIUM_INITIAL_DELAY_MS=15000
TRADE_PLAN_PREMIUM_ALERTS_ENABLED=true

# Deterministic recommendation scoring. Weights are relative and do not need to
# total 100. No recommendation places or sizes a trade.
RECOMMENDATION_ENABLED=true
RECOMMENDATION_MIN_CONFIDENCE=55
RECOMMENDATION_MIN_DIRECTIONAL_EDGE=5
RECOMMENDATION_PCR_BULLISH=1.20
RECOMMENDATION_PCR_BEARISH=0.80
RECOMMENDATION_HIGH_IV_RANK=80
RECOMMENDATION_LOW_IV_RANK=20
RECOMMENDATION_ALLOWED_EXPIRIES=WEEKLY,MONTHLY
RECOMMENDATION_EXPIRY_SELECTION=NEAREST
RECOMMENDATION_STRIKE_MODE=ATM
RECOMMENDATION_STRIKE_OFFSET_STEPS=0
RECOMMENDATION_MAX_STRIKE_STEPS=5
RECOMMENDATION_WEIGHT_TREND=20
RECOMMENDATION_WEIGHT_MOMENTUM=15
RECOMMENDATION_WEIGHT_VOLATILITY=5
RECOMMENDATION_WEIGHT_LIQUIDITY=10
RECOMMENDATION_WEIGHT_VOLUME=5
RECOMMENDATION_WEIGHT_OPEN_INTEREST=10
RECOMMENDATION_WEIGHT_OI_CHANGE=5
RECOMMENDATION_WEIGHT_PCR=5
RECOMMENDATION_WEIGHT_IV=5
RECOMMENDATION_WEIGHT_IV_RANK=5
RECOMMENDATION_WEIGHT_GREEKS=5
RECOMMENDATION_WEIGHT_EXPECTED_MOVE=5
RECOMMENDATION_WEIGHT_SUPPORT_RESISTANCE=5
RECOMMENDATION_WEIGHT_BREAKOUT=5
RECOMMENDATION_WEIGHT_MARKET_STRUCTURE=5
RECOMMENDATION_WEIGHT_TREND_ALIGNMENT=10
RECOMMENDATION_WEIGHT_RISK_REWARD=15
RECOMMENDATION_WEIGHT_QUALIFICATION=10
RECOMMENDATION_WEIGHT_STRATEGY_AGREEMENT=5
RECOMMENDATION_WEIGHT_MARKET_SESSION=5
RECOMMENDATION_WEIGHT_FRESHNESS=5

# Deterministic monitoring of manually recorded trades. It reuses existing
# engine outputs and never executes, modifies or closes an order.
MONITORING_ENABLED=true
MONITORING_WARNING_CONFIDENCE=65
MONITORING_EXIT_CONFIDENCE=45
MONITORING_CONFIDENCE_DETERIORATION=10
MONITORING_EDGE_DETERIORATION=8
MONITORING_COMPONENT_DETERIORATION=10
MONITORING_WARNING_COMPONENT_COUNT=1
MONITORING_AT_RISK_COMPONENT_COUNT=3
MONITORING_STRATEGY_DISAGREEMENT_SCORE=50
MONITORING_MAXIMUM_STALE_DURATION=2m
MONITORING_INTERVAL=EVENT_DRIVEN

# Comma-separated ISO market holiday dates. Blank until the current year's
# exchange list is loaded. Invalid dates fail startup explicitly.
NSE_HOLIDAYS=
BSE_HOLIDAYS=
MCX_HOLIDAYS=
