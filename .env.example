# Reference only. Spring Boot does not read this file automatically.
# Export these values in your shell, IDE run configuration, container, or Render environment.
# Never commit a populated copy.

SMARTAPI_ENABLED=false

SMARTAPI_API_KEY=
SMARTAPI_CLIENT_CODE=
SMARTAPI_PIN=
SMARTAPI_TOTP_SECRET=

# Required request metadata when SMARTAPI_ENABLED=true. The SmartAPI login
# endpoint rejects an otherwise valid login with AB1012 when these headers are absent.
SMARTAPI_CLIENT_LOCAL_IP=
SMARTAPI_CLIENT_PUBLIC_IP=
SMARTAPI_MAC_ADDRESS=

# Optional endpoint and reliability overrides.
SMARTAPI_BASE_URL=https://apiconnect.angelone.in
SMARTAPI_WEBSOCKET_URL=wss://smartapisocket.angelone.in/smart-stream
SMARTAPI_INSTRUMENT_MASTER_URL=https://margincalculator.angelone.in/OpenAPI_File/files/OpenAPIScripMaster.json
SMARTAPI_STATE=prod
SMARTAPI_CONNECT_TIMEOUT=5s
SMARTAPI_READ_TIMEOUT=20s
SMARTAPI_SESSION_EXPIRY_SKEW=60s
SMARTAPI_MAX_RETRIES=2
SMARTAPI_RETRY_BASE_DELAY=250ms
SMARTAPI_RETRY_MAX_DELAY=2s
